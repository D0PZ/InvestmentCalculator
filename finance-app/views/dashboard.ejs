<div class="page-header">
  <h1>Salud financiera · <%= yyyymm %></h1>
  <div style="display:flex;gap:14px;align-items:center">
    <% if (typeof fx !== 'undefined' && fx) { %>
      <small>USD/CLP: <strong><%= fx.rate ? fx.rate.toFixed(2) : '—' %></strong>
        <% if (fx.fetched_at) { %>· <%= new Date(fx.fetched_at).toLocaleDateString('es-CL') %><% } %>
      </small>
    <% } %>
    <form method="get" class="month-picker">
      <input type="month" name="month" value="<%= yyyymm %>" onchange="this.form.submit()" />
    </form>
  </div>
</div>

<div class="score-card score-<%= health.score >= 75 ? 'good' : health.score >= 50 ? 'warn' : 'bad' %>">
  <div class="score-value"><%= health.score %></div>
  <div class="score-label">Score de salud financiera</div>
</div>

<div class="grid grid-4">
  <div class="card stat">
    <div class="stat-label">Ingresos del mes</div>
    <div class="stat-value income"><%= clp(health.income) %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">Gastos consumo</div>
    <div class="stat-value expense"><%= clp(health.consumptionExpenses) %></div>
    <% if (health.investmentOutflow > 0) { %>
      <small>+ <%= clp(health.investmentOutflow) %> en inversiones (no resta del ahorro)</small>
    <% } %>
  </div>
  <div class="card stat">
    <div class="stat-label">Suscripciones</div>
    <div class="stat-value"><%= clp(health.subsMonthly) %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">Tasa de ahorro</div>
    <div class="stat-value <%= health.savingsRate >= 0.2 ? 'income' : health.savingsRate < 0.1 ? 'expense' : '' %>">
      <%= (health.savingsRate * 100).toFixed(1) %>%
    </div>
    <small>Capacidad: <%= clp(health.savingsCapacity) %></small>
  </div>
</div>

<div class="grid grid-3">
  <div class="card">
    <h3>Cash líquido</h3>
    <div class="big-num"><%= clp(health.liquidCash) %></div>
    <small>Débito + cuentas digitales + beneficios</small>
  </div>
  <div class="card">
    <h3>Crédito utilizado</h3>
    <div class="big-num"><%= clp(health.creditUsedTotal) %></div>
    <div class="bar"><div class="bar-fill <%= health.creditUsagePct > 0.7 ? 'bad' : health.creditUsagePct > 0.5 ? 'warn' : 'good' %>" style="width: <%= Math.min(100, health.creditUsagePct * 100) %>%"></div></div>
    <small><%= (health.creditUsagePct * 100).toFixed(1) %>% del cupo total</small>
  </div>
  <div class="card">
    <h3>Patrimonio total</h3>
    <div class="big-num"><%= clp(health.totalPatrimony) %></div>
    <small>Cash + inversiones − deuda</small>
    <% if (patrimonyReturns) { %>
      <div style="display:flex;gap:14px;margin-top:8px">
        <small>Mes:
          <% if (patrimonyReturns.month_return !== null) { %>
            <strong class="<%= patrimonyReturns.month_return >= 0 ? 'income' : 'expense' %>"><%= pctFromRatio(patrimonyReturns.month_return) %></strong>
            <span class="muted">(<%= signedClp(patrimonyReturns.month_delta) %>)</span>
          <% } else { %>
            <span class="muted">— (esperando snapshot inicial)</span>
          <% } %>
        </small>
        <small>Año:
          <% if (patrimonyReturns.year_return !== null) { %>
            <strong class="<%= patrimonyReturns.year_return >= 0 ? 'income' : 'expense' %>"><%= pctFromRatio(patrimonyReturns.year_return) %></strong>
          <% } else { %>
            <span class="muted">—</span>
          <% } %>
        </small>
      </div>
    <% } %>
  </div>
</div>

<% if (portfolioReturns && portfolioReturns.value_clp > 0) { %>
<div class="card">
  <h3>📈 Retorno del portafolio</h3>
  <div class="grid grid-4" style="margin-bottom:0">
    <div>
      <small>Valor actual</small>
      <div class="big-num"><%= clp(portfolioReturns.value_clp) %></div>
    </div>
    <div>
      <small>P/L total</small>
      <div class="big-num <%= portfolioReturns.pl_clp >= 0 ? 'income' : 'expense' %>"><%= signedClp(portfolioReturns.pl_clp) %></div>
      <small><%= pctFromRatio(portfolioReturns.total_return) %> vs costo</small>
    </div>
    <div>
      <small>% mes <% if (portfolioReturns.month_approx) { %><span class="muted">(aprox)</span><% } %></small>
      <div class="big-num <%= portfolioReturns.month_return >= 0 ? 'income' : 'expense' %>"><%= pctFromRatio(portfolioReturns.month_return) %></div>
    </div>
    <div>
      <small>% año (YTD) <% if (portfolioReturns.year_approx) { %><span class="muted">(aprox)</span><% } %></small>
      <div class="big-num <%= portfolioReturns.year_return >= 0 ? 'income' : 'expense' %>"><%= pctFromRatio(portfolioReturns.year_return) %></div>
    </div>
  </div>
</div>
<% } %>

<div class="grid grid-2">
  <div class="card">
    <h3>🎯 Aporte sugerido a Racional</h3>
    <div class="big-num accent"><%= clp(health.racionalSuggested) %></div>
    <small>Meta mensual: <%= clp(health.racionalGoalMin) %> – <%= clp(health.racionalGoalMax) %></small>
    <p style="margin-top:12px">Capacidad de ahorro este mes: <strong><%= clp(health.savingsCapacity) %></strong> (<%= (health.savingsRate*100).toFixed(1) %>% del ingreso)</p>
  </div>
  <div class="card">
    <h3>💡 Tips del mes</h3>
    <% if (health.tips.length === 0) { %>
      <p>Sin recomendaciones — vas bien.</p>
    <% } %>
    <% health.tips.forEach(t => { %>
      <div class="tip tip-<%= t.level %>">
        <strong><%= t.title %></strong>
        <p><%= t.body %></p>
      </div>
    <% }) %>
  </div>
</div>

<div class="grid grid-2">
  <div class="card">
    <h3>Top categorías de gasto</h3>
    <% if (health.categoryBreakdown.length === 0) { %>
      <p class="muted">Sin gastos este mes.</p>
    <% } else { %>
      <% const maxCat = health.categoryBreakdown[0].total; %>
      <% health.categoryBreakdown.forEach(c => { %>
        <div style="margin-bottom:10px">
          <div style="display:flex;justify-content:space-between;margin-bottom:4px">
            <span><%= c.category %> <small>(<%= c.n %>)</small></span>
            <strong><%= clp(c.total) %></strong>
          </div>
          <div class="bar"><div class="bar-fill" style="width:<%= (c.total/maxCat*100).toFixed(1) %>%;background:var(--accent)"></div></div>
        </div>
      <% }) %>
    <% } %>
  </div>
  <div class="card">
    <h3>Movimientos recientes</h3>
    <% if (recentTx.length === 0) { %>
      <p>Sin movimientos. <a href="/transactions">Agregar</a>.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Fecha</th><th>Descripción</th><th class="num">Monto</th></tr></thead>
        <tbody>
          <% recentTx.forEach(t => { %>
            <tr>
              <td><%= t.occurred_on %></td>
              <td><%= t.description || t.category || '—' %></td>
              <td class="num <%= t.kind === 'income' ? 'income' : 'expense' %>">
                <%= t.kind === 'income' ? '+' : '−' %><%= clp(t.amount) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
