<div class="live-page">
  <div class="live-header">
    <div>
      <h1>Live</h1>
      <div class="live-sub">
        <span id="connState" class="conn-pill conn-idle">conectando…</span>
        <span class="live-watch-label">watchlist:</span>
        <span id="watchlistChips" class="chip-row"></span>
      </div>
    </div>
    <% if (!feedReady) { %>
      <div class="live-warning">⚠ FINNHUB_API_KEY no está en <code>.env</code>. El feed no arrancará hasta que la agregues y reinicies.</div>
    <% } %>
  </div>

  <div id="marketBanner" class="market-banner market-<%= market.state %>" data-state="<%= market.state %>" data-next-open="<%= market.nextOpen %>" data-next-close="<%= market.nextClose %>">
    <div class="mb-left">
      <span class="mb-dot"></span>
      <strong id="mbState"><%= market.state === 'open' ? 'Mercado abierto' : market.state === 'pre-market' ? 'Pre-market' : market.state === 'after-hours' ? 'After-hours' : 'Mercado cerrado' %></strong>
      <span class="mb-ny">NY: <%= market.nyTime %></span>
    </div>
    <div class="mb-right">
      <span class="mb-label" id="mbLabel"><%= market.open ? 'cierra en' : 'abre en' %></span>
      <span class="mb-countdown" id="mbCountdown">—</span>
    </div>
  </div>

  <div class="strategy-bar">
    <div class="sb-item">
      <span class="sb-label">Estrategia</span>
      <strong>VWAP Reclaim Scalp</strong>
    </div>
    <div class="sb-item">
      <span class="sb-label">Bankroll (paper)</span>
      <strong id="sbBankroll" class="flat">$1000.00</strong>
      <small id="sbBankrollDelta" class="muted-sm">+$0.00</small>
    </div>
    <div class="sb-item">
      <span class="sb-label">Capital/trade</span>
      <strong>$100 USD</strong>
    </div>
    <div class="sb-item">
      <span class="sb-label">P&L hoy</span>
      <strong id="sbPnl" class="flat">$0.00</strong>
    </div>
    <div class="sb-item">
      <span class="sb-label">Trades · Win rate</span>
      <strong><span id="sbTrades">0</span> · <span id="sbWinRate">—</span></strong>
    </div>
    <div class="sb-item">
      <span class="sb-label">Posiciones abiertas (bot)</span>
      <strong id="sbOpen">0</strong>
    </div>
  </div>

  <section class="ml-panel" id="mlPanel" data-loaded="0">
    <header class="ml-header">
      <h3>🤖 Agente ML standalone</h3>
      <div class="ml-meta">
        <span id="mlVersion" class="muted-sm">—</span>
        <span class="muted-sm">·</span>
        <span id="mlThreshold" class="muted-sm">thr —</span>
        <button class="btn btn-sm" id="mlRefresh" type="button">↻</button>
      </div>
    </header>
    <div class="ml-bar">
      <div class="ml-stat"><span class="ml-label">Posiciones abiertas</span><strong id="mlOpenCount">0</strong></div>
      <div class="ml-stat"><span class="ml-label">Trades</span><strong id="mlTradesCount">0</strong></div>
      <div class="ml-stat"><span class="ml-label">Win rate</span><strong id="mlWinRate">—</strong></div>
      <div class="ml-stat"><span class="ml-label">P&L total</span><strong id="mlTotalPnl" class="flat">$0.00</strong></div>
      <div class="ml-stat"><span class="ml-label">Último ciclo</span><strong id="mlLastCycle" class="muted-sm">—</strong></div>
    </div>
    <div class="ml-body">
      <div class="ml-col">
        <h4>Posiciones abiertas</h4>
        <ul id="mlOpenList" class="ml-list"><li class="muted-sm">sin posiciones</li></ul>
      </div>
      <div class="ml-col">
        <h4>Trades recientes</h4>
        <ul id="mlTradesList" class="ml-list"><li class="muted-sm">sin trades</li></ul>
      </div>
    </div>
  </section>

  <section class="catalyst-panel" id="catalystPanel" data-loaded="0">
    <header class="cat-header">
      <h3>📡 Catalyst Radar <small class="muted-sm">eventos fundamentales · Finnhub</small></h3>
      <div class="cat-controls">
        <span id="catStatus" class="muted-sm">—</span>
        <button class="btn btn-sm" id="catRefresh" type="button">↻</button>
      </div>
    </header>
    <div class="cat-body">
      <table class="cat-table">
        <thead>
          <tr>
            <th>Ticker</th>
            <th>Próx. earnings</th>
            <th class="num">Consenso analistas</th>
            <th>Última acción de analista</th>
          </tr>
        </thead>
        <tbody id="catRows"><tr><td colspan="4" class="muted-sm">cargando…</td></tr></tbody>
      </table>
    </div>
  </section>

  <details class="live-debug">
    <summary>debug log</summary>
    <pre id="debugLog">esperando...</pre>
  </details>

  <section class="correlation-panel" id="correlationPanel" data-loaded="0">
    <header>
      <h3>Correlación de cartera vs índices</h3>
      <div class="cp-controls">
        <label>Ventana
          <select id="corrDays">
            <option value="14">14d</option>
            <option value="30" selected>30d</option>
            <option value="60">60d</option>
            <option value="90">90d</option>
          </select>
        </label>
        <button class="btn btn-sm" id="corrRefresh" type="button">↻</button>
      </div>
    </header>
    <div class="cp-body">
      <div class="cp-summary" id="cpSummary">cargando…</div>
      <div class="cp-benchmarks" id="cpBenchmarks"></div>
      <details class="cp-details">
        <summary>Detalle por ticker</summary>
        <table class="cp-table">
          <thead>
            <tr><th>Ticker</th><th class="num">Peso</th><th class="num">Cum</th><th class="num">corr SPY</th><th class="num">β SPY</th><th class="num">corr QQQ</th><th class="num">β QQQ</th></tr>
          </thead>
          <tbody id="cpTickerRows"></tbody>
        </table>
      </details>
    </div>
  </section>

  <section class="heatmap" id="heatmap"></section>

  <div class="live-grid">
    <section class="ticker-grid" id="tickerGrid"></section>

    <aside class="alerts-panel">
      <header>
        <h3>Alertas</h3>
        <span id="alertsCount" class="muted-sm">0</span>
      </header>
      <ol id="alertsList" class="alerts-list"></ol>
    </aside>
  </div>
</div>

<script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
<script>
  window.WATCHLIST = <%- safeJson(watchlist) %>;
</script>
<script src="/js/live.js" defer></script>
