<div class="page-header">
  <h1>Posiciones</h1>
  <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
    <% if (typeof fx !== 'undefined' && fx) { %>
      <small>FX USD/CLP: <strong><%= fx.rate ? fx.rate.toFixed(2) : '—' %></strong>
        <% if (fx.fetched_at) { %>· <%= new Date(fx.fetched_at).toLocaleString('es-CL') %><% } %>
        <% if (fx.fallback) { %>· <em style="color:var(--warn)">fallback</em><% } %>
      </small>
    <% } %>
    <form method="post" action="/positions/sync" style="display:inline"><button class="btn">⬇ Sync stock_scorer</button></form>
    <form method="post" action="/positions/refresh" style="display:inline"><button class="btn">↻ Refresh precios</button></form>
    <div class="big-num accent"><%= clp(total) %></div>
  </div>
</div>

<% if (flash) { %>
  <div class="tip tip-<%= flash.type === 'good' ? 'good' : 'danger' %>"><strong><%= flash.text %></strong></div>
<% } %>

<% if (positions.length > 0) { %>
  <% const totalPL = total - totalCost; %>
  <% const totalRet = totalCost ? (totalPL / totalCost) : 0; %>
  <div class="grid grid-3">
    <div class="card stat">
      <div class="stat-label">Costo total</div>
      <div class="stat-value"><%= clp(totalCost) %></div>
    </div>
    <div class="card stat">
      <div class="stat-label">P/L total</div>
      <div class="stat-value <%= totalPL >= 0 ? 'income' : 'expense' %>"><%= signedClp(totalPL) %></div>
      <small><%= pctFromRatio(totalRet) %></small>
    </div>
    <div class="card stat">
      <div class="stat-label">Posiciones</div>
      <div class="stat-value"><%= positions.length %></div>
    </div>
  </div>
<% } %>

<div class="card">
  <h3>🛒 Registrar compra</h3>
  <form method="post" action="/positions/buy" class="form-grid">
    <label>Ticker <input type="text" name="ticker" required placeholder="MSFT" /></label>
    <label>Monto USD <input type="number" name="usd_amount" step="0.01" min="0" required placeholder="22.00" /></label>
    <label>Precio/acción USD <input type="number" name="price_per_share" step="0.0001" min="0" required placeholder="412.77" /></label>
    <label>Fecha <input type="datetime-local" name="occurred_on" /></label>
    <label>Cuenta origen
      <select name="account_id">
        <option value="">— sin cuenta —</option>
        <% accounts.forEach(a => { %>
          <option value="<%= a.id %>"><%= a.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Descripción <input type="text" name="description" placeholder="opcional" /></label>
    <button type="submit" class="btn btn-primary">Registrar compra</button>
  </form>
  <small>Convierte USD→CLP con la tasa del día y registra el gasto en Movimientos (categoría "inversión", excluida del cálculo de tasa de ahorro).</small>
</div>

<div class="card">
  <h3>💸 Registrar venta</h3>
  <form method="post" action="/positions/sell" class="form-grid">
    <label>Ticker <input type="text" name="ticker" required placeholder="MSFT" /></label>
    <label>Monto USD <input type="number" name="usd_amount" step="0.01" min="0" required placeholder="105.71" /></label>
    <label>Precio/acción USD <input type="number" name="price_per_share" step="0.0001" min="0" required placeholder="409.84" /></label>
    <label>Fecha <input type="datetime-local" name="occurred_on" /></label>
    <button type="submit" class="btn">Registrar venta</button>
  </form>
  <small>Valida que tengas suficientes acciones para vender. La venta queda como trade SELL con FX actual.</small>
</div>

<div class="card">
  <h3>Detalle</h3>
  <table>
    <thead>
      <tr>
        <th>Ticker</th>
        <th class="num">Acciones</th>
        <th class="num">Costo prom.</th>
        <th class="num">Precio</th>
        <th class="num">Valor CLP</th>
        <th class="num">P/L</th>
        <th class="num">Total</th>
        <th class="num">Mes</th>
        <th class="num">Año</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% positions.forEach(p => { %>
        <tr>
          <td>
            <strong><%= p.ticker %></strong>
            <% if (p.trade_count) { %><small style="opacity:.6">(<%= p.trade_count %>)</small><% } %>
          </td>
          <td class="num"><%= p.shares.toFixed(7) %></td>
          <td class="num">$<%= p.avg_cost.toFixed(2) %></td>
          <td class="num">$<%= p.market_price.toFixed(2) %></td>
          <td class="num"><%= clp(p.value_clp) %></td>
          <td class="num <%= p.pl_clp >= 0 ? 'income' : 'expense' %>"><%= signedClp(p.pl_clp) %></td>
          <td class="num <%= p.total_return >= 0 ? 'income' : 'expense' %>"><%= pctFromRatio(p.total_return) %></td>
          <td class="num <%= p.month_return >= 0 ? 'income' : 'expense' %>" title="<%= p.month_ref_date || 'sin datos' %>"><%= pctFromRatio(p.month_return) %></td>
          <td class="num <%= p.year_return >= 0 ? 'income' : 'expense' %>" title="<%= p.year_ref_date || 'sin datos' %>"><%= pctFromRatio(p.year_return) %></td>
          <td>
            <form method="post" action="/positions/<%= p.ticker %>/close" onsubmit="return confirm('¿Borrar todos los trades de <%= p.ticker %>? Esto es destructivo.')">
              <button class="btn btn-danger btn-sm" title="Cerrar y borrar del historial">×</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <small>Mes/Año = retorno del precio desde inicio del período (datos históricos cacheados de Stooq). El tooltip muestra la fecha de referencia.</small>
</div>
