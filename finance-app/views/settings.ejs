<div class="page-header"><h1>Settings</h1></div>

<% if (flash) { %>
  <div class="tip tip-<%= flash.type === 'good' ? 'good' : 'danger' %>"><strong><%= flash.text %></strong></div>
<% } %>

<div class="grid grid-2">
  <div class="card">
    <h3>Cambiar contraseña</h3>
    <form method="post" action="/settings/password" class="form-grid">
      <label>Actual <input type="password" name="current" required /></label>
      <label>Nueva (mín 8) <input type="password" name="password" required minlength="8" /></label>
      <label>Confirmar <input type="password" name="confirm" required minlength="8" /></label>
      <button type="submit" class="btn btn-primary">Cambiar</button>
    </form>
  </div>

  <div class="card">
    <h3>FX USD/CLP</h3>
    <p>Actual: <strong><%= fx.rate ? fx.rate.toFixed(2) : '—' %></strong>
      <% if (fx.fetched_at) { %>· <%= new Date(fx.fetched_at).toLocaleString('es-CL') %><% } %>
      <% if (fx.fallback) { %>· <em style="color:var(--warn)">fallback 950</em><% } %>
      <% if (fx.manual) { %>· <em style="color:var(--accent)">manual</em><% } %>
    </p>
    <form method="post" action="/settings/fx/refresh" style="display:inline-block;margin-right:8px">
      <button class="btn">↻ Refrescar desde mindicador.cl</button>
    </form>
    <form method="post" action="/settings/fx/manual" class="form-grid" style="margin-top:14px">
      <label>Tasa manual <input type="number" name="rate" step="0.01" min="0" placeholder="905.36" required /></label>
      <button type="submit" class="btn">Aplicar manual</button>
    </form>
    <small>Útil si mindicador.cl no responde o quieres usar una tasa específica.</small>
  </div>
</div>

<div class="card">
  <h3>Stats de la base de datos</h3>
  <div class="grid grid-3">
    <div><small>Movimientos</small><div class="big-num"><%= counts.transactions %></div></div>
    <div><small>Cuentas</small><div class="big-num"><%= counts.accounts %></div></div>
    <div><small>Suscripciones</small><div class="big-num"><%= counts.subscriptions %></div></div>
    <div><small>Posiciones</small><div class="big-num"><%= counts.positions %></div></div>
    <div><small>Snapshots</small><div class="big-num"><%= counts.snapshots %></div></div>
    <div><small>Histórico precios</small><div class="big-num"><%= counts.priceHistory %></div></div>
  </div>
</div>
