<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Finanzas</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <nav class="nav">
    <div class="nav-brand">💰 Finanzas</div>
    <div class="nav-links">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Dashboard</a>
      <a href="/transactions" class="<%= currentPath.startsWith('/transactions') ? 'active' : '' %>">Movimientos</a>
      <a href="/accounts" class="<%= currentPath.startsWith('/accounts') ? 'active' : '' %>">Cuentas</a>
      <a href="/subscriptions" class="<%= currentPath.startsWith('/subscriptions') ? 'active' : '' %>">Suscripciones</a>
      <a href="/positions" class="<%= currentPath.startsWith('/positions') ? 'active' : '' %>">Posiciones</a>
      <a href="/live" class="<%= currentPath.startsWith('/live') ? 'active' : '' %>">Live</a>
      <a href="/settings" class="<%= currentPath.startsWith('/settings') ? 'active' : '' %>">⚙</a>
    </div>
    <form method="post" action="/logout" style="margin-left:auto"><button class="btn btn-sm">Salir</button></form>
  </nav>
  <main class="container">
    <%- body %>
  </main>
</body>
</html>
